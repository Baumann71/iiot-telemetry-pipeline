
# Versión EXACTA de la imagen apache/kafka
KAFKA_VERSION=

# Identificador del clúster, el mismo para los 3 nodos. 
KAFKA_CLUSTER_ID=

# Dirección con la que los clientes EXTERNOS (fuera de Docker) llegan a los
# brokers. localhost si corren en la misma máquina, en la VM la IP de Tailscale.
KAFKA_EXTERNAL_HOST=localhost

# Interfaz donde se publican los puertos 29092-29094. En local, vacío (todas las
# interfaces, IPv4 e IPv6); en la VM, la IP de Tailscale para no exponerlos a Internet.
# KAFKA_BIND_IP=

# Memoria por broker (opcionales; estos son los valores por defecto).
# KAFKA_HEAP_OPTS=-Xms256m -Xmx256m
# KAFKA_MEM_LIMIT=640m

# Kafka UI (opcionales; estos son los valores por defecto).
# KAFKA_UI_VERSION=v1.5.1
# KAFKA_UI_MEM_LIMIT=512m

# Brokers a los que el conector de EMQX publica (opcional). Por defecto los de
# la red de Docker; en la exposición, la IP de Tailscale de la VM con 29092-29094.
# KAFKA_BOOTSTRAP_HOSTS=kafka-1:9092,kafka-2:9092,kafka-3:9092

# Telegram para el grupo alertas (extra, opcional). Sin estas dos variables
# alertas solo imprime. El token lo da @BotFather; nunca commitearlo.
# TELEGRAM_TOKEN=
# TELEGRAM_CHAT_ID=¿

# TimescaleDB
TIMESCALE_VERSION=
POSTGRES_USER=telemetria
POSTGRES_PASSWORD=cambiar_esto
POSTGRES_DB=telemetria
# TIMESCALE_MEM_LIMIT=512m

# Grafana (http://localhost:3000)
GRAFANA_VERSION=12.4.0
# GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=cambiar_esto
# GRAFANA_MEM_LIMIT=256m